#!/bin/sh

set -eu

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
ACTIVE_DIR="/var/service"

usage()
{
    echo "Usage: $0 [SERVICE_DIRECTORY|--all]" >&2
    echo "  With one SERVICE_DIRECTORY: activate only that service." >&2
    echo "  With no args or --all: activate every sibling dir with executable run." >&2
    exit 2
}

activate_one()
{
    service_dir="$1"

    if [ ! -d "$service_dir" ] || [ ! -x "$service_dir/run" ]; then
        echo "Service must be a directory containing an executable run file:" >&2
        echo "  $service_dir/run" >&2
        return 2
    fi

    service_dir="$(readlink -f "$service_dir")"
    service_name="$(basename "$service_dir")"
    link="${ACTIVE_DIR}/${service_name}"

    if [ ! -d "$ACTIVE_DIR" ]; then
        echo "No Void runit directory was found: $ACTIVE_DIR" >&2
        return 1
    fi

    if [ -w "$ACTIVE_DIR" ] || [ "$(id -u)" -eq 0 ]; then
        ln -sfn "$service_dir" "$link"
    elif sudo -n ln -sfn "$service_dir" "$link" 2>/dev/null; then
        :
    else
        echo "Activation needs administrator access to $ACTIVE_DIR" >&2
        echo "The service definition is ready at: $service_dir" >&2
        echo "Run this command with the required privileges:" >&2
        echo "  sudo ln -sfn '$service_dir' '$link'" >&2
        return 1
    fi

    echo "Activated Void runit service: $service_name"
    echo "Source: $service_dir"
    echo "Active: $link"
    return 0
}

# Resolve argument mode
mode="all"
target=""
case "${1:-}" in
    "")
        mode="all"
        ;;
    --all)
        mode="all"
        ;;
    -h|--help)
        usage
        ;;
    *)
        if [ "$#" -ne 1 ]; then
            usage
        fi
        mode="one"
        target="$1"
        ;;
esac

rc=0
if [ "$mode" = "one" ]; then
    activate_one "$target" || rc=$?
else
    found=0
    for d in "$SCRIPT_DIR"/*/; do
        [ -d "$d" ] || continue
        [ -x "${d}run" ] || continue
        found=1
        activate_one "$d" || rc=$?
    done
    if [ "$found" -eq 0 ]; then
        echo "No service directories with executable run under: $SCRIPT_DIR" >&2
        exit 2
    fi
fi

exit "$rc"
