#!/bin/sh

set -eu

service_dir="${1:-}"

if [ -z "$service_dir" ]; then
    echo "Usage: $0 SERVICE_DIRECTORY" >&2
    exit 2
fi

if [ ! -d "$service_dir" ] || [ ! -x "$service_dir/run" ]; then
    echo "Service must be a directory containing an executable run file:" >&2
    echo "  $service_dir/run" >&2
    exit 2
fi

service_dir="$(readlink -f "$service_dir")"
service_name="$(basename "$service_dir")"

if [ -d /var/service ]; then
    if [ ! -w /var/service ] && [ "$(id -u)" -ne 0 ]; then
        echo "Activation needs administrator access to /var/service" >&2
        echo "The service definition is ready at: $service_dir" >&2
        echo "Run this command with the required privileges:" >&2
        echo "  ln -sfn '$service_dir' '/var/service/$service_name'" >&2
        exit 1
    fi

    ln -sfn "$service_dir" "/var/service/$service_name"
    echo "Activated Void runit service: $service_name"
    echo "Source: $service_dir"
    echo "Active: /var/service/$service_name"
    exit 0
fi

echo "No Void runit directory was found: /var/service" >&2
exit 1
