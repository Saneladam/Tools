#!/bin/sh

set -u

SERVICE_DIR="$(dirname "$(readlink -f "$0")")"
SERVICE_USER="$(stat -c '%U' "$SERVICE_DIR")"
if [ "$(id -un)" != "$SERVICE_USER" ]; then
    exec chpst -u "$SERVICE_USER" "$0"
fi

LOG_DIR="$HOME/Logs"
LOG_FILE="$LOG_DIR/session-service.log"
mkdir -p "$LOG_DIR"
exec >>"$LOG_FILE" 2>&1

printf '\n[%s] session-sync started on %s\n' "$(date)" "$(hostname)"

finish()
{
    trap - TERM INT HUP
    printf '[%s] stopping session-sync\n' "$(date)"
    "$HOME/Tools/bin/session" end
    exit $?
}

trap finish TERM INT HUP

"$HOME/Tools/bin/session" start

while :; do
    sleep 3600 &
    wait "$!"
done
