#!/bin/sh
# Run as the owner, with the correct HOME even when started by root/runit.
set -eu
service_dir="$(dirname "$(readlink -f "$0")")"
if [ -r "$service_dir/user" ]; then
    service_user="$(head -n 1 "$service_dir/user")"
else
    service_user="$(stat -c %U "$service_dir")"
fi
case "$service_user" in root|*[!a-zA-Z0-9_-]*|'') echo 'A non-root service user is required.' >&2; exit 1 ;; esac
service_home="$(getent passwd "$service_user" | cut -d: -f6)"
if [ "$(id -u)" -eq 0 ]; then
    exec chpst -u "$service_user" env -i HOME="$service_home" USER="$service_user" \
        PATH="$service_home/Tools/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" "$0"
fi
mkdir -p "$service_home/Logs/security"
exec >>"$service_home/Logs/security-service.log" 2>&1
export HOME="$service_home"
exec python3 "$HOME/Tools/bin/security-session"
