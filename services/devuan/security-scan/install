#!/bin/sh
# Install only this SysV service. Does not reboot or stop networking/SSH.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
source_dir="$(dirname "$(readlink -f "$0")")"
if [ "$(id -u)" -ne 0 ]; then
    if sudo -n true 2>/dev/null; then
        exec sudo "$0" "$@"
    fi
    printf 'Falta autorización administrativa. Ejecuta:\n  sudo %s\n' "$0" >&2
    exit 1
fi
owner="${SUDO_USER:-$(stat -c %U "$source_dir")}"
case "$owner" in root|*[!a-zA-Z0-9_-]*|'') echo 'No se pudo identificar usuario no-root.' >&2; exit 1 ;; esac
getent passwd "$owner" >/dev/null
[ "$(cat /proc/1/comm)" = init ] || { echo 'Este instalador es para Devuan con SysVinit.' >&2; exit 1; }
install -d -m 755 /usr/local/libexec
install -o root -g root -m 755 "$source_dir/../../security-system-facts" /usr/local/libexec/security-system-facts
install -o root -g root -m 755 "$source_dir/init.d" /etc/init.d/security-scan
config_temp="$(mktemp)"
trap 'rm -f "$config_temp"' EXIT HUP INT TERM
printf 'SECURITY_USER=%s\n' "$owner" >"$config_temp"
install -o root -g root -m 644 "$config_temp" /etc/default/security-scan
update-rc.d security-scan defaults
/etc/init.d/security-scan start
printf 'SysV security-scan habilitado para %s. No se ha apagado ni reiniciado el ordenador.\n' "$owner"
