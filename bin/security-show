#!/usr/bin/env python3
"""Show the most recent report (including today), optionally once per login."""
import argparse
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import sys

from security_core import clean, load_json, report_dir


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("-m", type=int, metavar="LINES", help="resumen de hasta N hallazgos")
    p.add_argument("--once", action="store_true", help="solo una vez por sesión gráfica/TTY/SSH")
    p.add_argument("--verbose", action="store_true", help="incluye inventario técnico")
    args = p.parse_args()
    if args.m is not None and not 1 <= args.m <= 100:
        p.error("-m debe estar entre 1 y 100")
    root = report_dir()
    report = load_json(root / "latest.json")
    if args.once and report:
        if not sys.stdout.isatty():
            return 0
        import hashlib
        boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        session = os.environ.get("XDG_SESSION_ID") or os.environ.get("SSH_CONNECTION") or os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY") or os.ttyname(0)
        token = hashlib.sha256((boot + ":" + session).encode()).hexdigest()[:20]
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
        with (root / (".shown-" + token)).open("a+") as marker:
            fcntl.flock(marker, fcntl.LOCK_EX)
            marker.seek(0)
            if marker.read():
                return 0
            marker.write("shown\n")
    if not report:
        # Never mistake a zero-byte file or a scanner traceback for a clean report.
        print("Seguridad: todavía no hay un informe válido de este ordenador. Ejecuta security-scan.")
        return 1
    if args.m is None:
        from security_core import text_report
        print(text_report(report, args.verbose), end="")
        print(f"Informe: {root / 'latest.log'}")
        return 0
    findings = sorted(report["findings"], key=lambda f: (f["level"] != "FAIL", f["id"]))
    skipped = report.get("skipped", [])
    print(f"Seguridad {report['host']} ({report['finished_at']}, {report.get('reason', '?')}): "
          f"{sum(f['level']=='FAIL' for f in findings)} críticos, {sum(f['level']=='WARN' for f in findings)} avisos; {len(skipped)} no verificados.")
    try:
        age = (dt.datetime.now().astimezone() - dt.datetime.fromisoformat(report["finished_at"])).total_seconds()
        if age > 48 * 3600:
            print(f"  AVISO: informe antiguo ({age / 86400:.0f} días); no describe necesariamente el estado actual.")
    except (ValueError, KeyError):
        print("  AVISO: fecha del informe no verificable.")
    for f in findings[:args.m]:
        print(f"  {f['level']}  {clean(f['title'])} — {clean(f['evidence'])}")
    if not findings:
        print("  Sin hallazgos en lo comprobado; no es una garantía de ausencia de amenazas.")
    if skipped:
        print("  Sin verificar: " + ", ".join(dict.fromkeys(clean(s["check"]) for s in skipped)))
    print(f"  Detalle y acciones: security-show | {root / 'latest.log'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
