#!/usr/bin/bash

#
# Created by: Roman
# On the 13/05/2026
#

battery=$( cat /sys/class/power_supply/BAT0/capacity 2>/dev/null )
date_info=$( date '+%a %d/%m/%Y' )
time_info=$( date '+%X' )
weather=$( cat "$HOME/Logs/weather.log" )

# echo "$weather        $time_info $date_info        $battery%"
printf '%s\t%s\t\t%s\t%s%%\t\n' \
    "$time_info" \
    "$date_info" \
    "$weather" \
    "$battery"
