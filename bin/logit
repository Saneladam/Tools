# =============================================================================
# To implement: 
#
#   [ ]     Make it pipeable. 
#              > logit 
#              > command ... | logit
#
#   [ ]     Register the name. 
#              ./% name 
#              ./% -t name 
#              ./% name -t 
#              jname=name
#
#   [ ]     Handle the job return with disown and nohup. 
#               fg disown nohup 
#
#   [ ]     get_job_stout with red for errors. 
#               job>>tmp 2>tmp.err
#               color(tmp.err) >> tmp
#
#   [ ]     Implemt the farewall protocol. 
#               while jPID; do
#                   ...
#               done
#               echo $FOOTER
#               run-time
#               errors
#               memory and CPU - GPU usage
#               --electricity_usage (external)
#               good-bye

# %% Configuration
HEADER="\tAUTO-LOGGER\t"
HEADER="\tEND of LOGFILE\t"
TEE=false
if [ $1 = "-t"  ]; then
    TEE=true
fi

# %% Definitions
jPID=$( ps au | grep T | tail -1 | awk '{print $11}' )
jtime=$( ps au | grep T | tail -1 | awk '{print $9}')
jname=$( ps au | grep T | tail -1 | awk '{print $1}')
date_info=$( date '+%a %d/%m/%Y' )
time_info=$( date '+%X' )

LOGDIR="$HOME/Logs/${jname}-${jtime}.log"

# %% Functions
get_jstat()  {
    ps au | grep $jPID | tail -1 | awk '{print $8}'
}
farewell(){
    # This funciton waits until the job is done / completed / interrupted or exited and prints the farewell message.
    case "get_jstat" in
        pattern)
            command ...
            ;;
        *)
            command ...
            ;;
    esac
    :
}
get_job_stout(){
    :
}

# %% Main
main() {

    echo "==============="
    echo "&&&&&&&&&&&&&&&"
    echo "***************"
    echo "$HEADER"
    echo "***************"
    printf '%s\t%s\t\t\n' \
        "$time_info" \
        "$date_info"
    echo "***************"
    printf 'Command:\t\t%s\n\tJOB PID:\t%s\t\n\tStart at:\t%s\t\n' \
        "$jname" \
        "$jPID" \
        "$jtime"
    echo "==============="
    get_job_stout
    echo "***************"
    echo "==============="

}

if ! (return 2>/dev/null); then
    if TEE; then
        main >> $LOGDIR
    else
        main | tee -a $LOGDIR
    fi
fi

